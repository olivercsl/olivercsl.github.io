# Read by Cloudflare when it serves the site (wrangler.jsonc); not served as a file.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Keep the workers.dev test address out of search results (Cloudflare's documented example).
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Every file under /_astro/ has a content hash in its name, so a changed file always gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
