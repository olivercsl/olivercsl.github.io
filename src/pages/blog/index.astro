---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const pageUrl = 'https://cloudzeta.solutions/blog/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${pageUrl}#blog`,
      name: 'Cloudzeta Notes',
      url: pageUrl,
      description:
        'Practical notes on infrastructure work: migrations, DNS, cloud architecture and the failure modes that are easy to miss.',
      publisher: { '@type': 'Organization', name: 'Cloudzeta Solutions', url: 'https://cloudzeta.solutions' },
      blogPost: posts.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        description: p.data.description,
        datePublished: p.data.published.toISOString(),
        author: { '@type': 'Person', name: p.data.author },
        url: `https://cloudzeta.solutions/blog/${p.id}`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cloudzeta.solutions/' },
        { '@type': 'ListItem', position: 2, name: 'Notes', item: pageUrl },
      ],
    },
  ],
};

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Notes | Practical Infrastructure Guides | Cloudzeta"
  description="Practical notes on infrastructure work: DNS migrations, cloud architecture, and the failure modes that are easy to miss. Written by engineers who do this work."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Navbar client:load />

  <main>
    <section class="pt-24 pb-12 md:pt-28 px-4 sm:px-6 bg-[radial-gradient(78%_120%_at_50%_-8%,#eef5ff_0%,#ffffff_58%)]">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-tx-primary leading-[1.08] mb-6">
          Notes
        </h1>
        <p class="text-lg md:text-xl text-tx-secondary leading-relaxed text-balance">
          Practical write-ups from infrastructure work we actually do, with the failure modes
          included rather than glossed over.
        </p>
      </div>
    </section>

    <section class="pb-24 px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        {
          posts.length === 0 ? (
            <p class="text-tx-secondary text-center">Nothing published yet.</p>
          ) : (
            <ul class="grid gap-5">
              {posts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}/`}
                    class="group block bg-white p-7 rounded-2xl border border-glass-border shadow-sm hover:shadow-lg transition-all"
                  >
                    <div class="flex flex-wrap items-center gap-3 mb-3 text-xs">
                      <span class="font-medium px-2.5 py-1 rounded-full bg-blue-50 text-blue-700">
                        {post.data.topic}
                      </span>
                      <time datetime={post.data.published.toISOString()} class="text-tx-secondary">
                        {fmtDate(post.data.published)}
                      </time>
                      <span class="text-tx-secondary">{post.data.readingMinutes} min read</span>
                    </div>
                    <h2 class="text-xl font-semibold text-tx-primary group-hover:text-accent transition-colors mb-2">
                      {post.data.title}
                    </h2>
                    <p class="text-tx-secondary leading-relaxed">{post.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <footer class="py-12 px-6 border-t border-glass-border">
      <p class="max-w-3xl mx-auto text-center text-sm text-tx-secondary">
        Written by <a href="/" class="text-tx-primary hover:text-accent font-medium">Cloudzeta Solutions</a>.
      </p>
    </footer>
  </main>
</Layout>
