---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const pageUrl = `https://cloudzeta.solutions/blog/${post.id}/`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#post`,
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.published.toISOString(),
      ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}),
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Person', name: post.data.author, url: 'https://cloudzeta.solutions' },
      articleSection: post.data.topic,
      inLanguage: 'en',
      publisher: {
        '@type': 'Organization',
        name: 'Cloudzeta Solutions',
        url: 'https://cloudzeta.solutions',
        logo: { '@type': 'ImageObject', url: 'https://cloudzeta.solutions/logo-circuit.svg' },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cloudzeta.solutions/' },
        { '@type': 'ListItem', position: 2, name: 'Notes', item: 'https://cloudzeta.solutions/blog/' },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
      ],
    },
  ],
};

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title={`${post.data.title} | Cloudzeta`}
  description={post.data.description}
  article={{
    published: post.data.published.toISOString(),
    modified: post.data.updated?.toISOString(),
    author: post.data.author,
    section: post.data.topic,
    tags: [post.data.topic],
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Navbar client:load />

  <main>
    <article class="pt-24 pb-16 md:pt-28 px-4 sm:px-6">
      <div class="max-w-2xl mx-auto">
        <a href="/blog/" class="text-sm text-tx-secondary hover:text-accent">&lsaquo; All notes</a>

        <div class="mt-6 mb-4">
          <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-50 text-blue-700">
            {post.data.topic}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-tx-primary leading-[1.15] mb-5">
          {post.data.title}
        </h1>
        <p class="text-lg text-tx-secondary leading-relaxed mb-6">
          {post.data.description}
        </p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-tx-secondary pb-8 mb-10 border-b border-glass-border">
          <span>By <span class="font-medium text-tx-primary">{post.data.author}</span></span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={post.data.published.toISOString()}>{fmtDate(post.data.published)}</time>
          {post.data.updated && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated{' '}
                <time datetime={post.data.updated.toISOString()}>{fmtDate(post.data.updated)}</time>
              </span>
            </>
          )}
          <span aria-hidden="true">&middot;</span>
          <span>{post.data.readingMinutes} min read</span>
        </div>

        <div class="prose-cz">
          <Content />
        </div>
      </div>
    </article>

    <footer class="py-12 px-6 border-t border-glass-border">
      <p class="max-w-2xl mx-auto text-center text-sm text-tx-secondary leading-relaxed">
        Written by <a href="/" class="text-tx-primary hover:text-accent font-medium">Cloudzeta
        Solutions</a>, an AWS Advanced Partner.
        <br class="hidden sm:block" />
        More <a href="/blog/" class="text-tx-primary hover:text-accent font-medium">notes</a> and
        <a href="/tools/" class="text-tx-primary hover:text-accent font-medium">free tools</a>.
      </p>
    </footer>
  </main>
</Layout>

<style is:global>
  /* Article typography. Scoped to .prose-cz so it never touches the tools. */
  .prose-cz {
    color: var(--color-tx-secondary);
    line-height: 1.75;
  }
  .prose-cz > * + * {
    margin-top: 1.25rem;
  }
  .prose-cz h2 {
    color: var(--color-tx-primary);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border);
  }
  .prose-cz h3 {
    color: var(--color-tx-primary);
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 6rem;
  }
  .prose-cz strong {
    color: var(--color-tx-primary);
    font-weight: 600;
  }
  .prose-cz a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-cz ul,
  .prose-cz ol {
    padding-left: 1.5rem;
  }
  .prose-cz ul {
    list-style: disc;
  }
  .prose-cz ol {
    list-style: decimal;
  }
  .prose-cz li + li {
    margin-top: 0.5rem;
  }
  .prose-cz li::marker {
    color: var(--color-tx-secondary);
  }
  .prose-cz code {
    font-size: 0.9em;
    background: var(--color-surface);
    border: 1px solid var(--glass-border);
    border-radius: 0.375rem;
    padding: 0.1em 0.35em;
    color: var(--color-tx-primary);
    word-break: break-all;
  }
  .prose-cz pre {
    background: var(--color-surface);
    border: 1px solid var(--glass-border);
    border-radius: 0.75rem;
    padding: 1rem 1.15rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .prose-cz pre code {
    background: none;
    border: none;
    padding: 0;
    word-break: normal;
    white-space: pre;
  }
</style>
