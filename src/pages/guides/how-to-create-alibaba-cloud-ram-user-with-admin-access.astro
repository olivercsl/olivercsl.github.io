---
/**
 * Customer onboarding guide: give Cloudzeta its own administrator sign-in on a
 * customer's Alibaba Cloud account, instead of the account owner's credentials.
 *
 * Deliberately under /guides/ rather than /docs/: robots.txt blocks /docs/,
 * and this page is meant to be found and indexed.
 *
 * Every console label below was checked against Alibaba Cloud's own RAM
 * documentation on 17 September 2026. Their console wording shifts between
 * versions, so where two labels are in use both are given.
 */
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';

const title = 'How to create an Alibaba Cloud RAM user with administrator access';
const description =
  'Step by step: create a RAM user for Cloudzeta, grant it the AdministratorAccess policy, find its logon name and password, and hand the details over securely. Based on Alibaba Cloud documentation.';
const published = new Date('2026-09-17T00:00:00Z');
const author = 'Oliver Zhang';
const pageUrl =
  'https://cloudzeta.solutions/guides/how-to-create-alibaba-cloud-ram-user-with-admin-access/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${pageUrl}#article`,
      headline: title,
      description,
      datePublished: published.toISOString(),
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Person', name: author, url: 'https://cloudzeta.solutions' },
      articleSection: 'Alibaba Cloud',
      inLanguage: 'en',
      publisher: {
        '@type': 'Organization',
        name: 'Cloudzeta Solutions',
        url: 'https://cloudzeta.solutions',
        logo: { '@type': 'ImageObject', url: 'https://cloudzeta.solutions/logo-circuit.svg' },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cloudzeta.solutions/' },
        { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
      ],
    },
  ],
};

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title={`${title} | Cloudzeta`}
  description={description}
  article={{
    published: published.toISOString(),
    author,
    section: 'Alibaba Cloud',
    tags: ['Alibaba Cloud', 'RAM', 'Onboarding'],
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Navbar client:load />

  <main>
    <article class="pt-24 pb-16 md:pt-28 px-4 sm:px-6">
      <div class="max-w-2xl mx-auto">
        <div class="mb-4">
          <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-50 text-blue-700">
            Customer guide
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-tx-primary leading-[1.15] mb-5">
          {title}
        </h1>
        <p class="text-lg text-tx-secondary leading-relaxed mb-6">
          Give Cloudzeta its own sign-in to manage your Alibaba Cloud account, so you never have to
          share the account owner's credentials.
        </p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-tx-secondary pb-8 mb-10 border-b border-glass-border">
          <span>By <span class="font-medium text-tx-primary">{author}</span></span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={published.toISOString()}>{fmtDate(published)}</time>
          <span aria-hidden="true">&middot;</span>
          <span>5 min read</span>
        </div>

        <div class="prose-cz">
          <p>
            To manage your Alibaba Cloud account, Cloudzeta needs to sign in to it. The safe way to
            allow that is a dedicated RAM user: a separate identity under your account, with its own
            logon name and password, that you control and can remove at any time. Your account owner
            credentials stay with you.
          </p>
          <p>
            This guide walks through the four steps, following Alibaba Cloud's Resource Access
            Management (RAM) documentation: create the user, grant it administrator access, collect
            its sign-in details, and send them to Cloudzeta. It takes about five minutes.
          </p>

          <h2>Before you start</h2>
          <p>
            Sign in to the <a href="https://ram.console.alibabacloud.com/">RAM console</a> with your
            Alibaba Cloud account, or as a RAM user that already has the
            <code>AliyunRAMFullAccess</code> policy. Alibaba Cloud's documentation requires one of the
            two to create users and grant permissions.
          </p>

          <h2>Step 1: Create the RAM user</h2>
          <ol>
            <li>
              In the left-side navigation pane, choose <strong>Identities</strong> &gt;
              <strong>Users</strong>, then click <strong>Create User</strong>.
            </li>
            <li>
              In <strong>Logon Name</strong>, enter a name that identifies us, such as
              <code>cloudzeta</code>. Alibaba Cloud allows up to 64 characters: letters, digits,
              periods, hyphens and underscores.
            </li>
            <li>
              In <strong>Display Name</strong>, enter something recognisable, such as
              <code>Cloudzeta Solutions</code>. This is optional.
            </li>
            <li>
              Under <strong>Access Mode</strong>, select <strong>Console Access</strong>.
            </li>
            <li>
              For the logon password, choose to generate it automatically, and select the option
              requiring a <strong>password reset at next logon</strong>. That way we set our own
              password on first sign-in, and the one you generated stops working.
            </li>
            <li>
              Leave <strong>MFA</strong> as required. Alibaba Cloud's documentation states that "MFA is
              required for all users by default", and the user binds an MFA device at first sign-in.
              We bind our own device when we first sign in, so there is no need to turn it off.
            </li>
            <li>Confirm to create the user.</li>
          </ol>
          <p>
            <strong>Copy the password as soon as it appears.</strong> Alibaba Cloud's documentation
            states that "the auto-generated password is displayed only once. It cannot be retrieved
            after you close the panel." If you miss it, see
            <a href="#if-you-lost-the-password">If you lost the password</a> below.
          </p>

          <h2>Step 2: Grant administrator access</h2>
          <p>
            A new RAM user has no permissions until you grant them. Administrator access comes from
            the <code>AdministratorAccess</code> system policy, which covers all resources in your
            account, including RAM itself.
          </p>
          <ol>
            <li>
              In the RAM console, choose <strong>Identities</strong> &gt; <strong>Users</strong>.
            </li>
            <li>
              Find the user you created and, in the <strong>Actions</strong> column, click
              <strong>Attach Policy</strong>. Some console versions label this
              <strong>Add Permissions</strong>.
            </li>
            <li>
              Set <strong>Resource Scope</strong> to <strong>Account level</strong>, so the access
              applies across the whole account.
            </li>
            <li>
              In the policy search box, type <code>AdministratorAccess</code> and select it. Alibaba
              Cloud recommends searching for it by name rather than paging through the list.
            </li>
            <li>Confirm to grant the permission.</li>
          </ol>
          <p>
            Expect a warning when you select the policy. Alibaba Cloud marks
            <code>AdministratorAccess</code> as a high-risk policy because it grants full control of
            the account. That warning is expected for this step, and you can confirm it.
          </p>

          <h2>Step 3: Find the logon name and password</h2>
          <p>We need three details to sign in:</p>
          <ul>
            <li>
              <strong>The password</strong> you copied in Step 1.
            </li>
            <li>
              <strong>The full logon name.</strong> A RAM user signs in with the logon name plus your
              account's logon suffix, in the form
              <code>cloudzeta@your-alias.onaliyun.com</code>. The part after the <code>@</code> is
              your default logon suffix.
            </li>
            <li>
              <strong>The RAM user logon URL.</strong> It takes the form
              <code>https://signin.alibabacloud.com/your-alias.onaliyun.com/login.htm</code>.
            </li>
          </ul>
          <p>
            You can find the default logon suffix and the logon URL on the
            <strong>Overview</strong> page of the RAM console. Alibaba Cloud's documentation directs
            account owners there to copy the URL for sharing with RAM users.
          </p>

          <h3 id="if-you-lost-the-password">If you lost the password</h3>
          <p>You can generate a new one without recreating the user:</p>
          <ol>
            <li>
              Choose <strong>Identities</strong> &gt; <strong>Users</strong>, and click the user's
              name.
            </li>
            <li>
              Open the <strong>Authentication</strong> tab and click
              <strong>Modify Logon Settings</strong>.
            </li>
            <li>
              Select <strong>Automatically Regenerate Default Password</strong>, and under
              <strong>Password Reset</strong> select <strong>Required at Next Logon</strong>.
            </li>
            <li>Click <strong>OK</strong>, then copy the new password straight away.</li>
          </ol>

          <h2>Step 4: Send the details to Cloudzeta</h2>
          <p>
            Send us the full logon name, the logon URL and the password.
          </p>
          <p>
            <strong>Please send the password securely.</strong> It gives administrator access to your
            whole Alibaba Cloud account, so treat it with the same care as the account itself.
          </p>
          <p>
            Once we have signed in for the first time, we will set our own password and bind our MFA
            device, and the password you sent will no longer work.
          </p>

          <h2>Staying in control</h2>
          <p>
            The RAM user belongs to your account, so you keep full control of it. You can remove the
            <code>AdministratorAccess</code> policy from the user, or delete the user entirely, from
            the RAM console at any time, and our access ends immediately.
          </p>

          <h2>Sources</h2>
          <p>
            The steps above follow Alibaba Cloud's RAM documentation:
          </p>
          <ul>
            <li>
              <a href="https://www.alibabacloud.com/help/en/ram/user-guide/create-a-ram-user">Create a RAM user</a>
            </li>
            <li>
              <a href="https://www.alibabacloud.com/help/en/ram/user-guide/grant-permissions-to-the-ram-user">Grant, view, and revoke RAM user permissions</a>
            </li>
            <li>
              <a href="https://www.alibabacloud.com/help/en/ram/user-guide/log-on-to-the-alibaba-cloud-management-console-as-a-ram-user">Log on to the Alibaba Cloud Management Console as a RAM user</a>
            </li>
            <li>
              <a href="https://www.alibabacloud.com/help/en/ram/user-guide/change-the-logon-password-of-a-ram-user-1">Reset a RAM user's console password</a>
            </li>
          </ul>
          <p>
            Alibaba Cloud updates its console from time to time, so a label may differ slightly from
            the wording here. The steps stay the same.
          </p>
        </div>
      </div>
    </article>

    <footer class="py-12 px-6 border-t border-glass-border">
      <p class="max-w-2xl mx-auto text-center text-sm text-tx-secondary leading-relaxed">
        A guide from <a href="/" class="text-tx-primary hover:text-accent font-medium">Cloudzeta
        Solutions</a>.
      </p>
    </footer>
  </main>
</Layout>

<style is:global>
  /* Same article typography as the notes, scoped to .prose-cz. */
  .prose-cz {
    color: var(--color-tx-secondary);
    line-height: 1.75;
  }
  .prose-cz > * + * {
    margin-top: 1.25rem;
  }
  .prose-cz h2 {
    color: var(--color-tx-primary);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border);
  }
  .prose-cz h3 {
    color: var(--color-tx-primary);
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 6rem;
  }
  .prose-cz strong {
    color: var(--color-tx-primary);
    font-weight: 600;
  }
  .prose-cz a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-cz ul,
  .prose-cz ol {
    padding-left: 1.5rem;
  }
  .prose-cz ul {
    list-style: disc;
  }
  .prose-cz ol {
    list-style: decimal;
  }
  .prose-cz li + li {
    margin-top: 0.5rem;
  }
  .prose-cz li::marker {
    color: var(--color-tx-secondary);
  }
  .prose-cz code {
    font-size: 0.9em;
    background: var(--color-surface);
    border: 1px solid var(--glass-border);
    border-radius: 0.375rem;
    padding: 0.1em 0.35em;
    color: var(--color-tx-primary);
    word-break: break-all;
  }
</style>
