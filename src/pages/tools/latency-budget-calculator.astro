---
/**
 * ============================================================================
 *  DO NOT ADD ANALYTICS, ADS, OR THIRD-PARTY SCRIPTS TO THIS PAGE.
 * ============================================================================
 *  Same commitment as the other tools: no ads, no trackers, works offline.
 *  Any external script makes those published claims false.
 * ============================================================================
 */
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import { LatencyBudgetAllocator } from '../../components/tools/LatencyBudgetAllocator';

const faqs = [
  {
    q: 'What is a latency budget?',
    a: 'An end to end response time target split across the components that consume it. If you have promised 200ms, and the gateway takes 15, the application 60 and the database 40, you know exactly how much is left for anything you add next.',
  },
  {
    q: 'Do component latencies simply add up?',
    a: 'For a request that passes through each component in turn, yes for averages. Not for percentiles. Two components with a 100ms p99 each do not produce a 200ms p99, because both are rarely slow on the same request. Adding percentiles is conservative, which is what you want when allocating a budget, but it is not a prediction of the measured figure.',
  },
  {
    q: 'How much latency does distance cost?',
    a: 'Light in fibre travels at roughly two thirds of its speed in vacuum, about 200km per millisecond, and a round trip covers the distance twice. Sydney to Singapore is around 6,300km, so about 63ms of round trip is unavoidable before any code runs. Real paths are longer than the straight line, so treat the figure as a floor.',
  },
  {
    q: 'Where should I spend optimisation effort?',
    a: 'On the largest component first. Halving something that takes 5ms of a 200ms budget moves the total less than measurement noise, while shaving 20% off the biggest contributor is usually visible immediately.',
  },
  {
    q: 'What if the components exceed the budget?',
    a: 'Three options, in rough order of cost. Run components in parallel rather than in series where the work is independent. Cut the largest contributor, usually with caching or a better query. Or renegotiate the target, which is far cheaper before you have built against it than after.',
  },
  {
    q: 'Is anything sent to a server?',
    a: 'No. The arithmetic runs in your browser and the page works offline.',
  },
];

const pageUrl = 'https://cloudzeta.solutions/tools/latency-budget-calculator';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#app`,
      name: 'Cloudzeta Latency Budget Calculator',
      url: pageUrl,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any modern web browser',
      description:
        'Free latency budget calculator. Split an end to end response time target across gateway, service, database and third-party calls, see what is left, and check the round trip floor imposed by distance. No ads, no tracking.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Split an end to end target across components',
        'Remaining budget and over-budget warning',
        'Largest contributor identified',
        'Round trip floor from distance in kilometres',
        'Runs offline. Nothing is sent to a server',
      ],
      publisher: {
        '@type': 'Organization',
        name: 'Cloudzeta Solutions',
        url: 'https://cloudzeta.solutions',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cloudzeta.solutions' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://cloudzeta.solutions/tools' },
        { '@type': 'ListItem', position: 3, name: 'Latency Budget Calculator', item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="Latency Budget Calculator | Split an End to End Target | Cloudzeta"
  description="Split a response time target across gateway, service, database and third-party calls. See what is left, which component dominates, and the round trip floor distance imposes. Free, no ads."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Navbar minimal client:load />

  <main>
    <section class="pt-20 pb-12 md:pt-28 md:pb-16 px-4 sm:px-6 bg-[radial-gradient(78%_120%_at_50%_-8%,#eef5ff_0%,#ffffff_58%)]">
      <div class="max-w-5xl mx-auto text-center mb-6 md:mb-7">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-tx-primary leading-[1.08]">
          Latency Budget Calculator
        </h1>
      </div>

      <div class="max-w-3xl mx-auto">
        <LatencyBudgetAllocator client:load />
        <p class="text-base text-tx-secondary text-center text-balance mt-6">
          You have 200ms end to end. This shows where it goes, what is left, and what distance takes
          before any code runs.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 px-6 bg-surface border-t border-glass-border">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-semibold text-tx-primary mb-12 text-center">
          Latency budget FAQs
        </h2>
        <div class="space-y-3">
          {
            faqs.map((faq) => (
              <details class="group bg-white border border-glass-border rounded-2xl overflow-hidden shadow-sm">
                <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-semibold text-tx-primary list-none hover:text-accent transition-colors">
                  {faq.q}
                  <svg class="w-5 h-5 shrink-0 text-tx-secondary transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </summary>
                <p class="px-6 pb-6 text-tx-secondary leading-relaxed">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <footer class="py-12 px-6 border-t border-glass-border">
      <p class="max-w-3xl mx-auto text-center text-sm text-tx-secondary leading-relaxed">
        A free tool from <a href="/" class="text-tx-primary hover:text-accent font-medium">Cloudzeta
        Solutions</a>. No ads, no tracking, no account. It stays that way.
        <br class="hidden sm:block" />
        See all <a href="/tools" class="text-tx-primary hover:text-accent font-medium">free tools</a>.
      </p>
    </footer>
  </main>
</Layout>
