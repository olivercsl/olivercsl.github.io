---
/**
 * ============================================================================
 *  DO NOT ADD ANALYTICS, ADS, OR THIRD-PARTY SCRIPTS TO THIS PAGE.
 * ============================================================================
 *  Same commitment as the other tools: no ads, no trackers, works offline.
 *  Any external script makes those published claims false.
 * ============================================================================
 */
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import { BackoffCalculator } from '../../components/tools/BackoffCalculator';

const faqs = [
  {
    q: 'What is exponential backoff?',
    a: 'A retry policy where each attempt waits longer than the last, usually doubling. A base of 100ms doubling five times gives 100, 200, 400, 800 and 1600ms. It gives a struggling dependency room to recover instead of hammering it at a fixed interval.',
  },
  {
    q: 'Why does backoff need jitter?',
    a: 'Without jitter every client that failed at the same moment retries at the same moment, so the load arrives in synchronised waves rather than spread out. Jitter randomises each delay so the retries land evenly. Full jitter picks a random value between zero and the computed delay; equal jitter keeps half the delay fixed and randomises the rest.',
  },
  {
    q: 'How many retries should I configure?',
    a: 'Few enough that the whole sequence finishes inside the timeout your caller enforces. Retrying after the caller has given up costs capacity and buys nothing. Enter your deadline above and the calculator marks the attempt that starts too late.',
  },
  {
    q: 'What is a retry storm?',
    a: 'When a dependency fails, every attempt fails, so every retry becomes another request. Three retries means four times the normal traffic arriving at a service that is already unhealthy, which keeps it down after the original cause has cleared. A circuit breaker that stops calling after a threshold of failures is what bounds this; jitter spreads the arrivals but does not reduce the total.',
  },
  {
    q: 'Should every failure be retried?',
    a: 'No. Retry timeouts, connection failures, 429 and 5xx responses. Do not retry 4xx client errors, because the same request will fail the same way. Non-idempotent writes need an idempotency key before they are safe to retry at all.',
  },
  {
    q: 'Is anything sent to a server?',
    a: 'No. The arithmetic runs in your browser and the page works offline.',
  },
];

const pageUrl = 'https://cloudzeta.solutions/tools/retry-backoff-calculator/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#app`,
      name: 'Cloudzeta Retry & Backoff Calculator',
      url: pageUrl,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any modern web browser',
      description:
        'Free exponential backoff calculator. See the full retry schedule with full or equal jitter, check it against your caller timeout, and see the load retries add to a failing dependency. No ads, no tracking.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Full retry schedule with delay and elapsed time per attempt',
        'Full jitter and equal jitter expected values',
        'Warns when a retry starts after the caller timeout',
        'Retry storm load multiplier on a failing dependency',
        'Runs offline. Nothing is sent to a server',
      ],
      publisher: {
        '@type': 'Organization',
        name: 'Cloudzeta Solutions',
        url: 'https://cloudzeta.solutions',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cloudzeta.solutions/' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://cloudzeta.solutions/tools/' },
        { '@type': 'ListItem', position: 3, name: 'Retry & Backoff Calculator', item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="Retry & Exponential Backoff Calculator | Jitter | Cloudzeta"
  description="See the full exponential backoff schedule with jitter, check it against your caller timeout, and measure the load retries add to a failing dependency. Free, no ads."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Navbar minimal client:load />

  <main>
    <section class="pt-20 pb-12 md:pt-28 md:pb-16 px-4 sm:px-6 bg-[radial-gradient(78%_120%_at_50%_-8%,#eef5ff_0%,#ffffff_58%)]">
      <div class="max-w-5xl mx-auto text-center mb-6 md:mb-7">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-tx-primary leading-[1.08]">
          Retry & Backoff Calculator
        </h1>
      </div>

      <div class="max-w-3xl mx-auto">
        <BackoffCalculator client:load />
        <p class="text-base text-tx-secondary text-center text-balance mt-6">
          How long your retries really take, and how much traffic they send at a service that is
          already down.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 px-6 bg-surface border-t border-glass-border">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-semibold text-tx-primary mb-12 text-center">
          Retry and backoff FAQs
        </h2>
        <div class="space-y-3">
          {
            faqs.map((faq) => (
              <details class="group bg-white border border-glass-border rounded-2xl overflow-hidden shadow-sm">
                <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-semibold text-tx-primary list-none hover:text-accent transition-colors">
                  {faq.q}
                  <svg class="w-5 h-5 shrink-0 text-tx-secondary transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </summary>
                <p class="px-6 pb-6 text-tx-secondary leading-relaxed">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <footer class="py-12 px-6 border-t border-glass-border">
      <p class="max-w-3xl mx-auto text-center text-sm text-tx-secondary leading-relaxed">
        A free tool from <a href="/" class="text-tx-primary hover:text-accent font-medium">Cloudzeta
        Solutions</a>. No ads, no tracking, no account. It stays that way.
        <br class="hidden sm:block" />
        See all <a href="/tools/" class="text-tx-primary hover:text-accent font-medium">free tools</a>.
      </p>
    </footer>
  </main>
</Layout>
