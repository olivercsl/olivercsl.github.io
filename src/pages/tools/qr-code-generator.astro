---
/**
 * ============================================================================
 *  DO NOT ADD ANALYTICS, ADS, OR THIRD-PARTY SCRIPTS TO THIS PAGE.
 * ============================================================================
 *  Same commitment as the other tools: no ads, no trackers, works offline.
 *  The QR is generated in the browser and points straight at the user's link —
 *  no tracking redirect. Any external script would break that promise.
 * ============================================================================
 */
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import { QrGenerator } from '../../components/tools/QrGenerator';

const faqs = [
  {
    q: 'Is this QR code generator free?',
    a: 'Yes, completely free with no account, no watermark and no limits. Generate as many codes as you like and download them as PNG or SVG.',
  },
  {
    q: 'Do the QR codes expire or get tracked?',
    a: 'No. Many free QR generators route the code through their own domain as a redirect, which lets them count scans and, in some cases, change or disable the link later. This one encodes your link directly into the code, in your browser. There is no redirect, no expiry and no tracking. The code works forever and points only where you told it to.',
  },
  {
    q: 'How do I turn a link into a QR code?',
    a: 'Paste the link into the Link box and the code appears straight away. Download it as PNG or SVG. If you type a bare address such as example.com, the tool adds https:// for you, because without it some phone cameras treat the code as text and offer a web search instead of opening the page.',
  },
  {
    q: 'Can a QR code be in colour?',
    a: 'Yes. Scanners care about contrast, not colour, so any dark shade on a light background works: navy, forest green, deep red, purple. Problems start when the two colours are close in brightness, such as yellow on white or mid grey on light grey. The tool warns you about low contrast and runs a scan check on the result.',
  },
  {
    q: 'How do I make a Wi-Fi QR code?',
    a: 'Choose Wi-Fi, enter the network name and password, and pick the security type, which is WPA for almost every modern router. Scanning it with an iPhone or Android camera offers to join the network, with no typing. The password is encoded into the code itself, so anyone who can see the code can join; print it for guests, not for a staff network.',
  },
  {
    q: 'Can I put a logo in the middle of a QR code?',
    a: 'Yes. Upload an image and it is placed in the centre, with the modules behind it cleared. The error correction is set to High, which lets a scanner rebuild up to about 30% of the code, and the logo is capped well under that. The scan check confirms the result still reads. Your image never leaves your browser.',
  },
  {
    q: 'Can I make a QR code with a transparent background?',
    a: 'Yes. Tick Transparent background and both downloads, PNG and SVG, leave the background empty so the code sits directly on your artwork. Put a dark code on a light area of the design, and keep a clear margin around it: scanners need the quiet zone to find the edges.',
  },
  {
    q: 'PNG or SVG: which should I download?',
    a: 'Use SVG for print, signage or anything that needs to scale, since it stays sharp at any size. Use PNG for slides, documents and the web, at 512, 1024 or 2048 pixels. 1024 suits most uses; pick 2048 for large prints if your printer will not take SVG.',
  },
  {
    q: 'What does the error-correction level do?',
    a: 'QR codes carry redundant data so they still scan when part of the code is dirty, creased or covered. Higher levels recover from more damage (roughly 7% at Low up to 30% at High) but leave less room for data, so the code becomes denser. Medium is a good default; raise it if the code will be printed small or placed somewhere it may get scuffed.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. The page is static and the codes are generated entirely in your browser, so once the page has loaded it keeps working with no connection. Nothing about your link is ever sent to a server.',
  },
];

const pageUrl = 'https://cloudzeta.solutions/tools/qr-code-generator/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#app`,
      name: 'Cloudzeta QR Code Generator',
      url: pageUrl,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'Any modern web browser',
      description:
        'Free QR code generator for links, Wi-Fi, contacts, email, phone and SMS. Custom colours, transparent background, logo and dot styles, with a scan check. Download PNG or SVG. Runs in the browser, no ads, no tracking redirect.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Links, text, Wi-Fi, email, phone, SMS and contact cards',
        'Custom colours and a transparent background',
        'Square, rounded or dot styles',
        'Logo in the centre, kept in your browser',
        'Scan check that reads the code back',
        'Adjustable error-correction level',
        'Download as PNG up to 2048 pixels or scalable SVG',
        'No tracking redirect. The code points straight at your link',
      ],
      publisher: { '@type': 'Organization', name: 'Cloudzeta Solutions', url: 'https://cloudzeta.solutions' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cloudzeta.solutions/' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://cloudzeta.solutions/tools/' },
        { '@type': 'ListItem', position: 3, name: 'QR Code Generator', item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="Free QR Code Generator | Colours, Logo, Wi-Fi, No Tracking"
  description="Turn a link, Wi-Fi network or contact into a QR code. Pick colours, add a logo, go transparent, and check it scans before you download PNG or SVG. No sign-up, no tracking redirect."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Navbar minimal client:load />

  <main>
    <section class="pt-20 pb-12 md:pt-28 md:pb-16 px-4 sm:px-6 bg-[radial-gradient(78%_120%_at_50%_-8%,#eef5ff_0%,#ffffff_58%)]">
      <div class="max-w-5xl mx-auto text-center mb-6 md:mb-7">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-tx-primary leading-[1.08]">
          QR Code Generator
        </h1>
      </div>

      <div class="max-w-3xl lg:max-w-4xl mx-auto">
        <QrGenerator client:load />
        <p class="text-base text-tx-secondary text-center text-balance mt-6">
          Links, Wi-Fi, contacts and more. Pick colours, add a logo, check it scans, download. No ads, no tracking redirect.
        </p>
      </div>
    </section>

    <!-- Why -->
    <section class="py-24 px-6 bg-surface border-y border-glass-border">
      <div class="max-w-3xl mx-auto">
        <div class="inline-block px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-6">
          Why this one
        </div>
        <h2 class="text-3xl md:text-4xl font-semibold text-tx-primary mb-6">
          Your link, encoded directly, not routed through us.
        </h2>
        <p class="text-lg text-tx-secondary leading-relaxed mb-6">
          A lot of free QR generators quietly wrap your link in a redirect through their own domain.
          That lets them count scans, show you an upsell, and sometimes change or switch off the link
          later. Your customers scan <em>their</em> URL, not yours. This tool encodes your link straight
          into the code, in your browser, so the QR points only where you told it to, and keeps working
          long after any service would have expired it.
        </p>
        <ul class="space-y-3">
          {
            [
              'The link is encoded directly: no redirect, no expiry, no scan tracking',
              'Generated in your browser; nothing about your link is sent anywhere',
              'Download as PNG for screens or SVG for print, with a scan check first',
              'No ads, no watermark, no account',
            ].map((item) => (
              <li class="flex items-start gap-3 text-tx-primary">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!--
      The widget needs input before it shows anything; this is the part a
      crawler reads, written for the searches the page already appears for:
      colour codes, links, Wi-Fi, logos and transparent backgrounds.
    -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto space-y-10">
        <div>
          <h2 class="text-2xl font-semibold text-tx-primary mb-3">Colour QR codes that still scan</h2>
          <p class="text-tx-secondary leading-relaxed">
            A scanner reads a QR code by telling dark modules from light ones, so what matters is
            contrast, not colour. Navy, forest green, burgundy or your brand purple on white all read
            as reliably as black. The failures come from pairs that are close in brightness, such as
            yellow on white or grey on grey, and from inverted codes, light on dark, which most phone
            cameras handle but some older scanner apps do not. The generator flags both, and its scan
            check reads the finished code back before you download it.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold text-tx-primary mb-3">Wi-Fi, contacts, email, calls and texts</h2>
          <p class="text-tx-secondary leading-relaxed mb-3">
            A QR code holds text, and phones recognise a few standard formats in that text. This tool
            writes them for you:
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-tx-secondary leading-relaxed">
            <li><strong class="text-tx-primary">Wi-Fi</strong> joins a network without typing the password, using the <span class="font-mono text-sm text-tx-primary">WIFI:T:WPA;S:name;P:password;;</span> format that iPhone and Android cameras read.</li>
            <li><strong class="text-tx-primary">Contact</strong> saves a person to the address book as a vCard, with name, company, phone, email and website.</li>
            <li><strong class="text-tx-primary">Email</strong> opens a new message with the address, subject and text filled in.</li>
            <li><strong class="text-tx-primary">Phone</strong> and <strong class="text-tx-primary">SMS</strong> start a call or a text. Include the country code so it works for visitors from abroad.</li>
          </ul>
        </div>

        <div>
          <h2 class="text-2xl font-semibold text-tx-primary mb-3">Logos and transparent backgrounds</h2>
          <p class="text-tx-secondary leading-relaxed">
            QR codes carry redundant data, which is what lets a logo cover the middle. At the High error
            correction level a scanner can rebuild about 30% of the code, so the logo is capped well below
            that and the modules behind it are cleared rather than drawn over. For print work, a
            transparent background lets the code sit directly on your design. Keep it dark on a light
            area and leave a clear margin around it, because scanners use that quiet zone to find the
            edges of the code.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-semibold text-tx-primary mb-12 text-center">
          QR code generator FAQs
        </h2>
        <div class="space-y-3">
          {
            faqs.map((faq) => (
              <details class="group bg-white border border-glass-border rounded-2xl overflow-hidden shadow-sm">
                <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-semibold text-tx-primary list-none hover:text-accent transition-colors">
                  {faq.q}
                  <svg class="w-5 h-5 shrink-0 text-tx-secondary transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </summary>
                <p class="px-6 pb-6 text-tx-secondary leading-relaxed">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <footer class="py-12 px-6 border-t border-glass-border">
      <p class="max-w-3xl mx-auto text-center text-sm text-tx-secondary leading-relaxed">
        A free tool from <a href="/" class="text-tx-primary hover:text-accent font-medium">Cloudzeta
        Solutions</a>. No ads, no tracking, no account. It stays that way.
        <br class="hidden sm:block" />
        See all <a href="/tools/" class="text-tx-primary hover:text-accent font-medium">free tools</a>.
      </p>
    </footer>
  </main>
</Layout>
